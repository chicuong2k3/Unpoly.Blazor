@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Antiforgery
@inject UnpolyOptions Options
@inject IAntiforgery Antiforgery

<link rel="stylesheet" href="_content/Unpoly.Blazor/unpoly.min.css" />
<script src="_content/Unpoly.Blazor/unpoly.min.js"></script>
<script>@(new MarkupString(BuildScript()))</script>

@code {
    // Null outside static SSR. Without it there is no request to mint a CSRF token for,
    // so the token line is simply omitted.
    [CascadingParameter] public HttpContext? Ctx { get; set; }

    static string Json(string s) => JsonSerializer.Serialize(s);

    string BuildScript()
    {
        var sb = new StringBuilder();

        // 📖 https://unpoly.com/targeting-fragments
        sb.Append("up.protocol.config.csrfHeader = ").Append(Json(Options.AntiforgeryHeaderName)).AppendLine(";");

        // Unpoly ships CSRF support: it sends csrfHeader on every unsafe request by itself.
        // Its default is to read <meta name="csrf-token">, but ASP.NET can hand us the token
        // directly, so no meta tag and no up:request:load listener are needed.
        // 📖 https://unpoly.com/up.protocol.config
        // RequestToken is nullable; without a token there is nothing useful to emit and
        // Unpoly would send the literal "null" on every unsafe request.
        if (Ctx is not null && Antiforgery.GetAndStoreTokens(Ctx).RequestToken is { } token)
            sb.Append("up.protocol.config.csrfToken = ").Append(Json(token)).AppendLine(";");

        sb.Append("up.fragment.config.mainTargets = ")
          .Append(JsonSerializer.Serialize(Options.MainTargets))
          .AppendLine(";");

        // 📖 https://unpoly.com/handling-everything
        if (Options.HandleAllLinksAndForms)
        {
            sb.AppendLine("up.link.config.followSelectors.push('a[href]');");
            sb.AppendLine("up.form.config.submitSelectors.push('form');");
        }

        // Opt out per element with [up-instant=false] / [up-preload=false].
        if (Options.InstantAllLinks)
            sb.AppendLine("up.link.config.instantSelectors.push('a[href]');");

        if (Options.PreloadAllLinks)
            sb.AppendLine("up.link.config.preloadSelectors.push('a[href]');");

        if (!string.IsNullOrWhiteSpace(Options.ExtraScript))
            sb.AppendLine(Options.ExtraScript);

        return sb.ToString();
    }
}
