@page "/"

<PageTitle>JUBIN — Trang chủ</PageTitle>

<div class="page-head">
    <h2>Spring Summer '26</h2>
    <p class="count">Đang giảm giá</p>
</div>

<ProductGrid Products="Catalog.Products.Where(p => p.OnSale).Take(8)" />

<p style="text-align:center;margin-top:3rem">
    <a class="back" href="/shop" up-target=".content" up-fallback="body">Xem tất cả sản phẩm →</a>
</p>

@* ── TARGET SYNTAX PLAYGROUND ────────────────────────────────────────────
   These links exist only to make target syntax observable in the Network tab.
   They are the sample's answer to concepts that have no C# side but are still
   worth seeing on the wire. 📖 https://unpoly.com/targeting-fragments
   ──────────────────────────────────────────────────────────────────────── *@
<section class="playground">
    <h3>Target syntax</h3>
    <p class="meta">Mở Network, bấm từng cái, xem header <code>X-Up-Target</code>.</p>

    <ul>
        <li>
            <a href="/shop" up-target=".content, .site-nav">Nhiều fragment</a>
            <span class="meta">§2 — <code>.content, .site-nav</code>, một response nuôi hai vùng</span>
        </li>
        <li>
            <a href="/shop" up-target=".content, .khong-ton-tai:maybe">Target tuỳ chọn</a>
            <span class="meta">§3 §18 — <code>:maybe</code> khiến vùng thiếu không làm hỏng swap</span>
        </li>
        <li>
            <a href="/shop" up-target=":main">Main element</a>
            <span class="meta">§4 — <code>:main</code> giải ra <code>mainTargets</code>; server coi là cả trang</span>
        </li>
        <li>
            <a href="/shop" up-target=".content:content">Thay toàn bộ con</a>
            <span class="meta">§8 — <code>:content</code> giữ lại chính <code>.content</code></span>
        </li>
        <li>
            <a href="/shop" up-target=":origin">Origin element</a>
            <span class="meta">§14 — <code>:origin</code> được giải thành selector suy ra TRƯỚC khi gửi header</span>
        </li>
        <li>
            <a href="/shop" up-target=".khong-ton-tai" up-fallback=":main">Target thiếu → fallback</a>
            <span class="meta">§15 §16 §17 — không khớp thì rơi về <code>:main</code></span>
        </li>
        <li>
            <a href="/shop" up-target=".content" up-instant up-preload>Instant + preload</a>
            <span class="meta">mousedown thay vì click, và prefetch khi hover — bật riêng cho link này</span>
        </li>
    </ul>
</section>
