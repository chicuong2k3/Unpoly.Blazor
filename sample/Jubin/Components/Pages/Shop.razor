@page "/shop"
@page "/shop/{Category}"

@if (!NotModified)
{
<PageTitle>@Heading — JUBIN</PageTitle>

<div class="page-head">
    <h2>@Heading</h2>
    <p class="count">@Items.Count sản phẩm</p>
</div>

@* [up-etag] gives this fragment its own version, so reloading just this region can be
   answered 304 independently of the page. \📖 https://unpoly.com/conditional-requests *@
@* [up-autosubmit] submits as soon as a value changes; [up-watch-delay] debounces so a
   slider or a text box does not fire per keystroke. No C# involved in either.
   📖 https://unpoly.com/watch-options *@
<form method="get" class="filters" up-autosubmit up-watch-delay="300" up-target=".listing">
    <label>
        Bộ sưu tập
        <select name="collection">
            <option value="">Tất cả</option>
            @foreach (var (slug, name) in Catalog.Collections)
            {
                <option value="@slug" selected="@(Collection == slug)">@name</option>
            }
        </select>
    </label>
    <label>
        Giá tối đa
        <select name="maxPrice">
            <option value="">Không giới hạn</option>
            <option value="400000" selected="@(MaxPrice == 400000)">400.000₫</option>
            <option value="600000" selected="@(MaxPrice == 600000)">600.000₫</option>
            <option value="900000" selected="@(MaxPrice == 900000)">900.000₫</option>
        </select>
    </label>
    <noscript><button class="btn-quiet" type="submit">Lọc</button></noscript>
</form>

<div class="listing" up-etag="@Catalog.ETag">
    <ProductGrid Products="Items" />
</div>

@* INFINITE SCROLL. [up-target=".listing:after, .more"] is a target LIST doing two different
   jobs in one response: append into .listing, replace .more. Without the `:after` modifier
   the second page would replace the first instead of extending it.
   [up-defer=reveal] loads it when the link scrolls into view, so there is no button to press.
   📖 https://unpoly.com/infinite-scrolling *@
<div class="more">
    @if (HasMore)
    {
        @* [up-defer=reveal] is the trigger: this loads itself when scrolled into view.
           Do NOT also make it inviting to click -- both paths fire, and the same page is
           appended twice. That is what makes it infinite scroll rather than a button. *@
        <a href="@NextUrl" up-target=".listing:after, .more" up-defer="reveal" up-follow="false">
            Đang tải thêm… (@Shown/@Total)
        </a>
    }
    else if (Total > 0)
    {
        <span class="meta">Đã hiển thị hết @Total sản phẩm</span>
    }
</div>

@* Explicit [up-target] instead of falling through to mainTargets, plus [up-fallback] for
   when .listing is missing from either side. 📖 https://unpoly.com/targeting-fragments *@
<form method="post" @formname="refresh" @onsubmit="Refresh"
      up-target=".content" up-fallback="body" class="refresh">
    <AntiforgeryToken />
    <button class="btn-quiet" type="submit">Làm mới kho (expire)</button>
    <button class="btn-quiet" type="submit" name="mode" value="evict">Làm mới kho (evict)</button>
</form>
<p class="meta">Phiên bản: @Catalog.ETag</p>

@* [up-etag=false] removes the version from a fragment, so reloading it never gets a 304.
   📖 https://unpoly.com/conditional-requests *@
<p class="meta" up-etag="false">Vùng này khai <code>up-etag="false"</code> — không có phiên bản, không bao giờ được trả 304.</p>
}

@code {
    [CascadingParameter] public HttpContext Ctx { get; set; } = default!;

    [Parameter] public string? Category { get; set; }

    [SupplyParameterFromQuery] public string? Collection { get; set; }
    [SupplyParameterFromQuery] public int? MaxPrice { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }

    const int PerPage = 12;

    int Total;
    int Shown => Math.Min((Page ?? 1) * PerPage, Total);
    bool HasMore => Shown < Total;

    string NextUrl
    {
        get
        {
            var q = new List<string> { $"page={(Page ?? 1) + 1}" };
            if (!string.IsNullOrEmpty(Collection)) q.Add($"collection={Collection}");
            if (MaxPrice is { } m) q.Add($"maxPrice={m}");
            var path = Category is null ? "/shop" : $"/shop/{Category}";
            return $"{path}?{string.Join("&", q)}";
        }
    }

    List<Product> Items = [];
    bool NotModified;

    string Heading => Category is null ? "Tất cả sản phẩm" : Catalog.CategoryName(Category);

    void Refresh()
    {
        // Mutating the data is what makes the conditional path meaningful: until something
        // changes, 304 has only ever been proven in its "unchanged" direction.
        Catalog.Touch();

        // Redundant on its own — Unpoly expires the whole cache after any non-GET — but it
        // is the narrower form, and the only way this header gets exercised at all.
        // 📖 https://unpoly.com/X-Up-Expire-Cache
        // Expire keeps stale content renderable while it refetches; evict throws it away so
        // the user waits for the network instead of seeing a stale flash. The button chooses.
        // \📖 https://unpoly.com/caching
        if (Ctx.Request.Form["mode"] == "evict")
            Ctx.UpEvictCache("/shop*");
        else
            Ctx.UpExpireCache("/shop*");

        // The button sits inside .content, but say so explicitly so the swap does not depend
        // on what the client happened to ask for. 📖 https://unpoly.com/targeting-fragments
        Ctx.UpRetarget(".content");
    }

    protected override void OnParametersSet()
    {
        // Publishes ETag/Last-Modified and answers 304 when the client is already current.
        // Unpoly uses conditional requests for reload, revalidation and polling.
        // 📖 https://unpoly.com/conditional-requests
        NotModified = Ctx.UpNotModified(Catalog.ETag, Catalog.LastModified);

        var q = Catalog.ByCategory(Category);

        if (!string.IsNullOrEmpty(Collection))
            q = q.Where(p => p.Collection == Collection);

        if (MaxPrice is { } max)
            q = q.Where(p => p.Effective <= max);

        var all = q.ToList();
        Total = all.Count;

        // A page request appends, so it must return ONLY the new slice. A first page returns
        // everything up to the cursor, which is what a direct visit or a Back needs.
        Items = NotModified
            ? []
            : Page is { } p and > 1
                ? [.. all.Skip((p - 1) * PerPage).Take(PerPage)]
                : [.. all.Take(PerPage)];
    }
}
