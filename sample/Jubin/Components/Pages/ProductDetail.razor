@page "/p/{Slug}"

@* Rendered by the page, not the layout: a page's form handler runs before the page's own
   markup, so this is the first place in the render pass that can see the flash.
   Read ONCE into a local -- TakeFlash() clears as it reads, and a property evaluated twice
   (once in the condition, once in the body) renders an empty message.
   📖 https://unpoly.com/flashes *@
@{
    var flash = Cart.TakeFlash();

    // Emitted on the GET that follows the redirect, so it is not lost with the 302.
    // 📖 https://unpoly.com/X-Up-Events
    if (Cart.TakeEvent() is { } ev)
    {
        Ctx.UpEmit(ev.Type, new { count = ev.Count, slug = ev.Slug });
    }
}
@if (flash is not null)
{
    <div class="flashes" up-flashes><p class="flash">@flash</p></div>
}

@if (Item is null)
{
    <div class="page-head">
        <h2>Không tìm thấy sản phẩm</h2>
    </div>
    <p style="text-align:center"><a class="back" href="/shop">← Về cửa hàng</a></p>
}
else
{
    <PageTitle>@Item.Name — JUBIN</PageTitle>

    <div class="detail">
        <figure style="margin:0">
            <div class="thumb">
                @Item.Name[0]
                @if (Item.OnSale)
                {
                    <span class="badge">Sale</span>
                }
            </div>
        </figure>

        <div>
            <a class="back" href="/shop/@Item.Category">← @Catalog.CategoryName(Item.Category)</a>

            <h2>@Item.Name</h2>

            <p class="price">
                @if (Item.OnSale)
                {
                    <s>@Money(Item.Price)</s><span class="now">@Money(Item.Effective)</span>
                }
                else
                {
                    <span>@Money(Item.Price)</span>
                }
            </p>

            @* THE SUBINTERACTION. The size picker is a real route; [up-layer=new] turns it
               into an overlay, and this page stays exactly as it is behind it. When the
               overlay accepts, `value` is whatever the server passed to UpAcceptLayer.
               📖 https://unpoly.com/subinteractions *@
            <p>
                <a class="btn" href="/p/@Item.Slug/size"
                   up-layer="new modal" up-size="small"
                   up-context='{ "from": "product" }'
                   up-on-accepted="onSizeChosen(value)">
                    Chọn size
                </a>
            </p>

            <p class="meta">Size đã chọn: <strong class="chosen-size">chưa chọn</strong></p>

            @* An [up-on-*] attribute is evaluated as ONE expression. A multi-line body of
               statements silently does nothing -- the callback runs, the value arrives, and
               no DOM changes. A named function keeps the attribute to one call. *@
            <script>
                function onSizeChosen(value) {
                    document.querySelector('.chosen-size').textContent = value.size;
                    document.querySelector('.add-to-cart').disabled = false;
                }
            </script>

            <form method="post" @formname="addToCart" @onsubmit="AddToCart">
                <AntiforgeryToken />
                <button class="btn add-to-cart" type="submit" disabled>Thêm vào giỏ</button>
            </form>

            @* [up-poll] reloads this on an interval. Because the fragment carries [up-etag],
               an unchanged poll is answered 304 and nothing re-renders -- the conditional
               request work from Phase B is what makes polling cheap.
               📖 https://unpoly.com/polling *@
            <p class="meta stock" up-poll up-interval="4000" up-etag="@Cart.ETag">
                Giỏ hàng hiện có <strong>@Cart.Count</strong> món · cập nhật mỗi 4s
            </p>

            @* The server decides this one opens as a drawer, even though the link says nothing.
               📖 https://unpoly.com/opening-overlays *@
            <p class="meta">
                <a class="back" href="/p/@Item.Slug/size?serverOpens=1">
                    Chọn size (để SERVER quyết định mở drawer)
                </a>
            </p>

            <p class="meta">Bộ sưu tập: @Item.Collection</p>

            @* [up-target=":none"] means the client wants no content back. The handler answers
               204 and renders nothing. 📖 https://unpoly.com/targeting-fragments *@
            <form method="post" @formname="ping" @onsubmit="Ping" up-target=":none">
                <AntiforgeryToken />
                <button class="btn-quiet" type="submit">Ghi nhận đã xem (:none)</button>
            </form>
        </div>
    </div>
}

@code {
    [CascadingParameter] public HttpContext Ctx { get; set; } = default!;
    [Inject] public NavigationManager Nav { get; set; } = default!;

    [Parameter] public string Slug { get; set; } = "";

    Product? Item;

    static string Money(decimal d) => $"{d:N0}₫";

    static int viewPings;

    void Ping()
    {
        viewPings++;

        // The client asked for nothing, so send nothing. Rendering a body here would be
        // wasted bytes the client discards.
        if (Ctx.WantsNothing())
            Ctx.Response.StatusCode = StatusCodes.Status204NoContent;
    }

    void AddToCart()
    {
        if (Item is null) return;

        Cart.Add(Item.Slug, Item.Name);

        // POST-redirect-GET, and not for the usual reason.
        //
        // In Blazor static SSR the LAYOUT's render tree is built before the page's form
        // handler runs -- markup position does not matter, below @Body is no better than
        // above it. So anything in the layout that reflects the mutation, such as the
        // [up-hungry] cart badge, renders the value from BEFORE the click. It swaps
        // correctly and shows a stale number, which looks exactly like [up-hungry] being
        // broken.
        //
        // Redirecting means the whole document is rendered fresh, after the change. Unpoly
        // follows the redirect and reads headers from the final response, so the flash and
        // the event survive -- they are held on Cart until the GET consumes them.
        Nav.NavigateTo($"/p/{Item.Slug}");
    }

    protected override void OnParametersSet()
    {
        Item = Catalog.BySlug(Slug);

        // [up-poll] echoes the fragment's [up-etag] as If-None-Match. Answering 304 is what
        // makes polling cheap -- without this the poll costs a full render every 4 seconds.
        // The conditional-request work from Phase B is what pays off here.
        // 📖 https://unpoly.com/polling
        Ctx.UpNotModified(Cart.ETag, Cart.LastChanged);
    }
}
