@page "/lab"
@page "/lab/{Case}"

@* ── THE LAB ─────────────────────────────────────────────────────────────
   Every concept here is client-side: the library has no C# for it. That does
   not make it undemonstrable, and leaving it undemonstrated is how seven
   target-syntax variants sat unexercised for three phases.

   One link per concept, labelled with the guide section it comes from.
   Open DevTools > Network and watch the X-Up-* headers.
   ─────────────────────────────────────────────────────────────────────── *@

<PageTitle>Lab — JUBIN</PageTitle>

<div class="page-head">
    <h2>Lab</h2>
    <p class="count">Các khái niệm client-side, quan sát trong Network tab</p>
</div>

@if (Case == "titled")
{
    <p class="notice">
        Tiêu đề tài liệu do <code>X-Up-Title</code> đặt, không phải <code>&lt;PageTitle&gt;</code>.
    </p>
}
else if (Case == "relocated")
{
    <p class="notice">
        URL đã request là <code>/lab/relocated</code>, nhưng <code>X-Up-Location</code>
        bảo trình duyệt hiện <code>/lab/somewhere-else</code>.
    </p>
}
else if (Case == "slow")
{
    <p class="notice">
        Route chậm (@DelayMs ms)@(Which is null ? "" : $" — từ: {Which}").
        Mỗi link mang query riêng nên không dính cache của nhau.
    </p>
}
else if (Case == "unauthorized")
{
    <p class="notice">Route này trả 200 kèm header <code>X-Unauthorized</code>.</p>
}
else
{
    <section class="playground">
        <h3>Fragment targeting <span class="meta">/targeting-fragments</span></h3>
        <ul>
            <li>
                <a href="/shop" up-target=".content, .site-nav">Nhiều fragment</a>
                <span class="meta">§2 — một response nuôi hai vùng. <code>.site-nav</code> nằm trong chrome nên <code>UpChrome Provides</code> phải khai báo nó</span>
            </li>
            <li>
                <a href="/shop" up-target=".content, .khong-ton-tai:maybe">Target tuỳ chọn</a>
                <span class="meta">§3 §18 — <code>:maybe</code> khiến vùng thiếu không làm hỏng swap</span>
            </li>
            <li>
                <a href="/shop" up-target=":main">Main element</a>
                <span class="meta">§4 — giải ra <code>mainTargets</code>; server coi là cả trang</span>
            </li>
            <li>
                <a href="/shop" up-target=".content:content">Thay toàn bộ con</a>
                <span class="meta">§8 — <code>:content</code> giữ lại chính phần tử</span>
            </li>
            <li>
                <a href="/shop" up-target=":origin">Origin element</a>
                <span class="meta">§14 — giải thành selector suy ra TRƯỚC khi gửi header</span>
            </li>
            <li>
                <a href="/shop" up-target=".khong-ton-tai" up-fallback=":main">Target thiếu → fallback</a>
                <span class="meta">§15 §16 §17 — không khớp thì rơi về <code>:main</code></span>
            </li>
        </ul>

        <h3>Selector matching <span class="meta">/targeting-fragments §10–§13</span></h3>

        <p class="meta">
            Hai thẻ <code>.demo-card</code> giống hệt nhau bên dưới. Chúng tồn tại để selector
            trở nên nhập nhằng — không có chúng thì không demo được §10–§13.
        </p>

        <div class="demo-card">
            <p><strong>Card A</strong> <span class="demo-text">chưa đổi</span></p>
            <a href="/lab" up-target=".demo-card .demo-text">Ancestor: <code>.demo-card .demo-text</code></a>
            <span class="meta">§11 — selector lồng nhau bình thường; Unpoly chọn cái <em>gần</em> link nhất</span>
        </div>

        <div class="demo-card">
            <p><strong>Card B</strong> <span class="demo-text">chưa đổi</span></p>
            <a href="/lab" up-target=".demo-text">Nhập nhằng: <code>.demo-text</code></a>
            <span class="meta">§10 — hai phần tử cùng khớp; region-aware matching chọn cái trong Card B</span>
            <a href="/lab" up-target=".demo-text" up-match="first">Cùng thế nhưng <code>up-match="first"</code></a>
            <span class="meta">§13 — tắt region-aware: luôn lấy cái đầu tiên trong DOM, tức Card A</span>
        </div>

        <ul>
            <li>
                <a href="/lab" up-target=".demo-text" up-content="đã đổi bằng local content">Local content</a>
                <span class="meta">
                    /failed-responses §4 — <code>[up-content]</code> render thẳng chuỗi này, không phát
                    request nào. Không có response thì không có gì để thất bại — đó là ý của section
                </span>
            </li>
        </ul>

        <h3>Links <span class="meta">/handling-everything</span></h3>

        <p class="meta warn">
            Cả hai link dưới đây trỏ vào route chậm 1.2s và mang query riêng, vì:
            cache sống 15s nên nếu trùng URL thì lần hover thứ hai không phát request nào,
            và route nhanh thì không thấy khác biệt. Đây là lý do demo cũ trông như không chạy.
        </p>

        <ul>
            <li>
                <a href="/lab/slow?case=instant" up-target=".content" up-instant>Instant</a>
                <span class="meta">
                    §2 — phát request ngay ở <strong>mousedown</strong>, không đợi thả chuột.
                    Cách xem: giữ chuột xuống 1 giây rồi mới thả — request đã chạy từ lúc nhấn.
                    So với link Preload bên dưới khi chưa hover.
                </span>
            </li>
            <li>
                <a href="/lab/slow?case=preload" up-target=".content" up-preload>Preload</a>
                <span class="meta">
                    §3 — prefetch khi hover. Cách xem: <strong>rê chuột lên và giữ yên hơn 90ms</strong>
                    (<code>up.link.config.preloadDelay</code>), request hiện trong Network trước khi bấm.
                    Lướt chuột qua nhanh thì không kịp kích hoạt.
                </span>
            </li>
            <li>
                <a href="/lab/slow?case=preload-insert" up-target=".content" up-preload="insert">Preload khi chèn</a>
                <span class="meta">
                    §3 — <code>[up-preload=insert]</code> tải ngay khi link vào DOM, không đợi hover.
                    Request này đã chạy lúc trang lab vừa render.
                </span>
            </li>
            <li>
                <a href="/shop" up-follow="false">Bỏ qua Unpoly</a>
                <span class="meta">opt-out — full page load, không có <code>X-Up-*</code></span>
            </li>
            <li>
                <a href="/shop" up-target=".content" up-confirm="Đi tiếp?">Confirm</a>
                <span class="meta">hỏi trước khi phát request</span>
            </li>
        </ul>

        <h3>Network <span class="meta">/caching · /progress-bar</span></h3>
        <ul>
            <li>
                <a href="/shop" up-target=".content" up-cache="false">Bỏ cache</a>
                <span class="meta">/caching §2–6 — luôn đi mạng, không dùng bản cache 15 s</span>
            </li>
            <li>
                <a href="/lab/slow?case=progress" up-target=".content">Route chậm (progress bar)</a>
                <span class="meta">/progress-bar — vượt <code>lateDelay</code> nên thanh tiến trình hiện ra</span>
            </li>
            <li>
                <a href="/lab/slow?case=background" up-target=".content" up-background>Route chậm, background</a>
                <span class="meta">/progress-bar — <code>[up-background]</code> không bao giờ hiện thanh</span>
            </li>
            <li>
                <a href="/lab/slow?case=nobar" up-target=".content" up-late-delay="false">Route chậm, không thanh</a>
                <span class="meta">
                    /progress-bar — <code>[up-late-delay=false]</code> tắt thanh cho riêng request này.
                    Bản phạm vi hẹp của <code>up.network.config.progressBar = false</code>
                </span>
            </li>
            <li>
                <a href="/shop" up-target=".content">Cache: bấm hai lần</a>
                <span class="meta">
                    /caching §1 — bấm, quay lại, bấm nữa trong vòng 15s.
                    Lần hai <strong>không có dòng nào</strong> trong request log. Cache là thứ quan sát
                    được bằng chính sự vắng mặt của request
                </span>
            </li>
            <li>
                <a href="/shop" up-target=".content" up-revalidate="false">Không revalidate</a>
                <span class="meta">
                    /caching §11–§12 — render bản cache rồi <em>dừng</em>, không fetch lại.
                    So số dòng log với link ngay trên
                </span>
            </li>
        </ul>

        <h3>Failed responses <span class="meta">/failed-responses</span></h3>
        <ul>
            <li>
                <a href="/khong-ton-tai" up-target=".content" up-fail-target="body">404 → fail target</a>
                <span class="meta">§1 — <code>[up-fail-target]</code>. Server thấy <code>X-Up-Fail-Target: body</code> nên giữ lại chrome</span>
            </li>
            <li>
                <a href="/khong-ton-tai" up-target=".content" up-fail="false">404 nhưng bỏ qua lỗi</a>
                <span class="meta">§2 — <code>[up-fail=false]</code> coi mọi response là thành công</span>
            </li>
            <li>
                <a href="/khong-ton-tai" up-target=".content" up-fail-target=".demo-text"
                   up-on-fail-rendered="alert('onFailRendered chạy: ' + response.status)">404 → callback</a>
                <span class="meta">
                    §8 — <code>[up-on-fail-rendered]</code> là bản HTML của <code>onFailRendered</code>.
                    Nhánh <code>fail</code> có callback riêng, không phải chỉ có target riêng
                </span>
            </li>
            <li>
                <a href="/lab/unauthorized" up-target=".content">200 + X-Unauthorized</a>
                <span class="meta">§3 — <code>up.network.config.fail</code> đã được nới trong <code>ExtraScript</code> để coi header này là lỗi</span>
            </li>
        </ul>
    </section>

    <h3>History <span class="meta">/updating-history</span></h3>
    <ul>
        <li>
            <a href="/lab/titled" up-target=".content">Server đặt tiêu đề</a>
            <span class="meta">
                <code>X-Up-Title</code> — giá trị là <strong>JSON-encoded</strong>, dấu nháy nằm
                trong header: <code>"Tiêu đề"</code>. Gửi trần là hỏng
            </span>
        </li>
        <li>
            <a href="/lab/relocated" up-target=".content">Server đổi URL hiển thị</a>
            <span class="meta">
                <code>X-Up-Location</code> — thanh địa chỉ hiện URL server chỉ định,
                không phải URL đã request
            </span>
        </li>
        <li>
            <a href="/shop" up-target=".content" up-history="false">Không đụng history</a>
            <span class="meta">/updating-history — swap mà thanh địa chỉ đứng yên</span>
        </li>
    </ul>

    <h3>Layers <span class="meta">/layer-option · /closing-overlays</span></h3>
    <ul>
        <li>
            <a href="/p/dam-4/size" up-layer="new modal" up-size="small"
               up-on-accepted="alert('accepted: ' + JSON.stringify(value))"
               up-on-dismissed="alert('dismissed: ' + JSON.stringify(value))">Modal</a>
            <span class="meta">
                /layer-terminology — mode <code>modal</code>. Chọn size thì <strong>accept</strong>,
                bấm Huỷ hoặc Esc thì <strong>dismiss</strong>. Hai thứ khác nhau, không thay thế nhau
            </span>
        </li>
        <li>
            <a href="/p/dam-4/size" up-layer="new drawer" up-size="medium">Drawer</a>
            <span class="meta">/layer-terminology — cùng route, mode khác</span>
        </li>
        <li>
            <a href="/p/dam-4/size" up-layer="new popup" up-align="left">Popup</a>
            <span class="meta">/layer-terminology — neo vào chính link này</span>
        </li>
        <li>
            <a href="/p/dam-4/size" up-layer="new cover">Cover</a>
            <span class="meta">/layer-terminology — phủ toàn màn hình</span>
        </li>
        <li>
            <a href="/p/dam-4/size?serverOpens=1">Server tự quyết mở drawer</a>
            <span class="meta">
                /opening-overlays — link không khai <code>[up-layer]</code>;
                response mang <code>X-Up-Open-Layer</code> nên vẫn thành drawer
            </span>
        </li>
        <li>
            <a href="/p/dam-4/size" up-layer="new modal"
               up-context='{ "flavour": "lab" }'>Modal có context</a>
            <span class="meta">
                /context — overlay in ra <code>X-Up-Context</code> nó nhận được,
                và trả về context đã đổi khi accept
            </span>
        </li>
        <li>
            <a href="/shop" up-layer="new modal">Mở /shop trong modal</a>
            <span class="meta">
                /optimizing-responses §5 — cùng một route, server thấy
                <code>X-Up-Mode: modal</code> và có thể render khác đi
            </span>
        </li>
    </ul>

    <h3>JavaScript API <span class="meta">up.render · up.submit</span></h3>
    <p class="meta">
        Hai thứ duy nhất ở đây không dùng được bằng attribute. Chúng vẫn demo được, chỉ là
        phải viết JS.
    </p>
    <ul>
        <li>
            <button class="btn-quiet" type="button"
                    onclick="up.render({ target: document.querySelector('.demo-text'), url: '/lab' })">
                <code>up.render</code> với Element
            </button>
            <span class="meta">
                /targeting-fragments §6 — truyền thẳng Element thay vì chuỗi selector;
                Unpoly tự suy ra selector trước khi gửi <code>X-Up-Target</code>
            </span>
        </li>
    </ul>

    <p class="meta lab-back"><a class="back" href="/lab">← Về lab</a></p>
}

@code {
    [CascadingParameter] public HttpContext Ctx { get; set; } = default!;

    [Parameter] public string? Case { get; set; }

    const int DelayMs = 1200;

    // Distinct query per link, so each is its own cache entry. Without this the 15s cache
    // makes the second hover fire nothing, which reads as "preload is broken".
    string? Which => Ctx.Request.Query["case"].ToString() is { Length: > 0 } c ? c : null;

    protected override async Task OnParametersSetAsync()
    {
        if (Case == "slow")
        {
            // Long enough to exceed up.network.config.lateDelay so the bar appears.
            await Task.Delay(DelayMs);
        }
        else if (Case == "titled")
        {
            // JSON-encoded, quotes included. The method does the encoding so a bare string
            // cannot be sent by accident. 📖 https://unpoly.com/X-Up-Title
            Ctx.UpTitle("Tiêu đề do server đặt — JUBIN");
        }
        else if (Case == "relocated")
        {
            Ctx.UpLocation("/lab/somewhere-else");
        }
        else if (Case == "unauthorized")
        {
            // A 200 the client has been configured to treat as a failure.
            // 📖 https://unpoly.com/failed-responses (Customizing failure detection)
            Ctx.Response.Headers["X-Unauthorized"] = "1";
        }
    }
}
