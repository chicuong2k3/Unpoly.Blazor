@* Shared product grid. No photography in this sample — the tinted panel with an initial
   reads as a deliberate placeholder rather than a broken image. *@

<div class="grid">
    @foreach (var p in Products)
    {
        <article class="card">
            <a href="/p/@p.Slug">
                <figure>
                    <div class="thumb">
                        @p.Name[0]
                        @if (p.OnSale)
                        {
                            <span class="badge">Sale</span>
                        }
                    </div>
                </figure>
                <h3>@p.Name</h3>
                <p class="price">
                    @if (p.OnSale)
                    {
                        <s>@Money(p.Price)</s><span class="now">@Money(p.Effective)</span>
                    }
                    else
                    {
                        <span>@Money(p.Price)</span>
                    }
                </p>
            </a>
        </article>
    }
</div>

@if (!Products.Any())
{
    <p class="empty">Không có sản phẩm nào.</p>
}

@code {
    [Parameter, EditorRequired] public IEnumerable<Product> Products { get; set; } = [];

    static string Money(decimal d) => $"{d:N0}₫";
}
